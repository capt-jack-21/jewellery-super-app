{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    },
    "lint": {},
    "test": {
      "dependsOn": [
        "^build"
      ]
    },
    "@jw/api#build": {
      "dependsOn": [
        "^build",
        "@jw/mod-sales#build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "@jw/api#typecheck": {
      "dependsOn": [
        "^build",
        "@jw/mod-sales#build"
      ]
    },
    "@jw/mod-sales#build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    }
  },
  "globalDependencies": [
    "contracts/openapi.yaml"
  ]
}
